---
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';
import { isActive, nav } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div class="bg-ink text-fog">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2 text-sm">
    <p>
      <time datetime={Astro.props.iso}>{Astro.props.dateLabel}</time>
    </p>
    <nav aria-label="Kurumsal" class="flex flex-wrap gap-x-4">
      <a class="inline-flex min-h-11 items-center hover:text-mint" href="/hakkimizda">Hakkımızda</a>
      <a class="inline-flex min-h-11 items-center hover:text-mint" href="/iletisim">İletişim</a>
      <a class="inline-flex min-h-11 items-center hover:text-mint" href="/kunye">Künye</a>
    </nav>
  </div>
</div>

<header class="on-dark bg-navy text-cream">
  <div class="wrap flex items-center justify-between gap-2 py-4 sm:gap-4">
    <a href="/" class="inline-flex min-w-0 items-center gap-2 text-cream hover:text-cream sm:gap-3">
      <Logo />
      <Wordmark class="text-[1.35rem] min-[380px]:text-[1.7rem] sm:text-[1.875rem]" />
      <span class="sr-only">ana sayfa</span>
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Ana menü">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center text-[0.95rem] font-semibold hover:text-mint"
            aria-current={isActive(item.href, path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <a class="btn btn-ghost" href="/ara" aria-label="Arama sayfası">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-4-4"></path>
        </svg>
      </a>
      <a class="btn hidden md:inline-flex" href="/#bulten">Bültene katıl</a>
      <details class="relative lg:hidden">
        <summary class="btn btn-ghost list-none" aria-label="Menü">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="absolute right-0 z-30 mt-2 w-64 rounded-[10px] border border-slate bg-navy p-3" aria-label="Mobil menü">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="flex min-h-11 items-center rounded px-2 font-semibold hover:text-mint"
                aria-current={isActive(item.href, path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="flex min-h-11 items-center rounded px-2 font-semibold hover:text-mint" href="/#bulten">Bültene katıl</a>
        </nav>
      </details>
    </div>
  </div>
  <div class="h-[3px] bg-gold" aria-hidden="true"></div>
</header>
