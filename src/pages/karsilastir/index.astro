---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CompareCard from '../../components/CompareCard.astro';
import { allComparisons } from '../../lib/comparisons';
import { pageMeta } from '../../lib/site';

const pairs = allComparisons();
const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Karşılaştırma', href: '/karsilastir' },
];
const description = pageMeta('karsilastir');
---

<BaseLayout title="Karşılaştırma" description={description} crumbs={crumbs}>
  <main id="icerik" class="compare wrap py-8" tabindex="-1" data-pagefind-body>
    <Breadcrumb crumbs={crumbs} />
    <h1 class="mb-3">Karşılaştırma</h1>
    <p class="compare-lead">Her kartta iki model alt alta. Adın altında fiyat var. Menzil kaynakta yazıyorsa fiyatın altında durur.</p>
    <div class="grid gap-5 md:grid-cols-3">
      {pairs.map((pair) => <CompareCard pair={pair} />)}
    </div>
  </main>
</BaseLayout>
