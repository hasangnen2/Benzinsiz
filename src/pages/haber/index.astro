---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContentList from '../../components/ContentList.astro';
import { loadArticles, slicePage } from '../../lib/articles';
import { pageMeta } from '../../lib/site';

const all = (await loadArticles()).filter((item) => item.type === 'haber');
const view = slicePage(all, 1);
const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Haberler', href: '/haber' },
];
const description = pageMeta('haber');
---

<BaseLayout title="Haberler" description={description} crumbs={crumbs} next={view.totalPages > 1 ? '/haber/sayfa/2' : undefined}>
  <main id="icerik" class="news wrap py-8" tabindex="-1" data-pagefind-body>
    <Breadcrumb crumbs={crumbs} />
    <h1 class="news-page-title">Haberler</h1>
    <p class="news-dek">Yeni haberler üstte. Başlığın altında haberin özeti var.</p>
    <ContentList items={view.items} page={1} totalPages={view.totalPages} total={view.total} base="/haber" current="haber" />
  </main>
</BaseLayout>
