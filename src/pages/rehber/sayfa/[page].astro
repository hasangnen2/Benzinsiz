---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ContentList from '../../../components/ContentList.astro';
import { PAGE_SIZE, loadArticles, slicePage } from '../../../lib/articles';
import { pageMeta } from '../../../lib/site';

export async function getStaticPaths() {
  const all = (await loadArticles()).filter((item) => item.type === 'rehber');
  const pages = Math.ceil(all.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}

const page = Number(Astro.params.page);
const all = (await loadArticles()).filter((item) => item.type === 'rehber');
const view = slicePage(all, page);
const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Rehberler', href: '/rehber' },
  { name: `Sayfa ${view.page}`, href: `/rehber/sayfa/${view.page}` },
];
const description = pageMeta('rehber');
const prev = view.page > 2 ? `/rehber/sayfa/${view.page - 1}` : '/rehber';
const next = view.page < view.totalPages ? `/rehber/sayfa/${view.page + 1}` : undefined;
---

<BaseLayout title={`Rehberler, sayfa ${view.page}`} description={description} crumbs={crumbs} prev={prev} next={next}>
  <main id="icerik" class="wrap py-8" tabindex="-1" data-pagefind-body>
    <Breadcrumb crumbs={crumbs} />
    <h1 class="mb-3 font-serif text-4xl">Rehberler</h1>
    <p class="max-w-[68ch] text-muted">{description}</p>
    <ContentList items={view.items} page={view.page} totalPages={view.totalPages} total={view.total} base="/rehber" current="rehber" />
  </main>
</BaseLayout>
