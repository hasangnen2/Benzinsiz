---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ChargeCalculator from '../../components/ChargeCalculator.astro';
import { pageMeta } from '../../lib/site';

const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Araçlar', href: '/arac' },
  { name: 'Şarj maliyeti', href: '/arac/hesaplayici' },
];
const description = pageMeta('hesaplayici');
---

<BaseLayout title="Şarj maliyeti hesaplayıcı" description={description} crumbs={crumbs}>
  <main id="icerik" class="wrap max-w-3xl py-8" tabindex="-1" data-pagefind-body>
    <Breadcrumb crumbs={crumbs} />
    <p class="tag m-0">Hesaplayıcı</p>
    <h1 class="mt-2 mb-3 font-serif text-4xl">Şarj maliyeti hesaplayıcı</h1>
    <p class="text-muted">{description} Ondalık için virgül kullan: 12,5. Binlik ayırıcı yazma.</p>
    <ChargeCalculator />
  </main>
</BaseLayout>
