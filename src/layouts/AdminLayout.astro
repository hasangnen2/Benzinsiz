---
import '../styles/global.css';
import '../styles/admin.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-ext-700.css';

interface Props {
  title: string;
  panel: string;
}

const { title, panel } = Astro.props;
const groups = [
  { label: '', links: [{ href: '/admin', id: 'ozet', label: 'Özet', badge: '' }] },
  {
    label: 'İçerik',
    links: [
      { href: '/admin/yazilar', id: 'yazilar', label: 'Yazılar', badge: 'articles' },
      { href: '/admin/sayfalar', id: 'sayfalar', label: 'Sayfalar', badge: 'pages' },
      { href: '/admin/kategoriler', id: 'kategoriler', label: 'Kategoriler', badge: 'categories' },
      { href: '/admin/medya', id: 'medya', label: 'Medya', badge: 'media' },
    ],
  },
  {
    label: 'Veri',
    links: [
      { href: '/admin/tarifeler', id: 'tarifeler', label: 'Tarifeler', badge: 'tariffs' },
      { href: '/admin/araclar', id: 'araclar', label: 'Araçlar', badge: 'cars' },
      { href: '/admin/sss', id: 'sss', label: 'Sorular', badge: 'faqs' },
    ],
  },
  {
    label: 'Site',
    links: [
      { href: '/admin/yazarlar', id: 'yazarlar', label: 'Kadrolar', badge: 'authors' },
      { href: '/admin/menu', id: 'menu', label: 'Menü ve footer', badge: '' },
      { href: '/admin/yonlendirmeler', id: 'yonlendirmeler', label: 'Yönlendirme', badge: 'redirects' },
      { href: '/admin/seo', id: 'seo', label: 'SEO', badge: '' },
    ],
  },
  {
    label: 'Büyüme',
    links: [
      { href: '/admin/reklam', id: 'reklam', label: 'Reklam', badge: '' },
      { href: '/admin/bulten', id: 'bulten', label: 'Bülten', badge: '' },
      { href: '/admin/analitik', id: 'analitik', label: 'Analitik', badge: '' },
    ],
  },
  {
    label: 'Sistem',
    links: [
      { href: '/admin/kullanicilar', id: 'kullanicilar', label: 'Kullanıcılar', badge: '' },
      { href: '/admin/yedekler', id: 'yedekler', label: 'Yedekler', badge: '' },
      { href: '/admin/gunluk', id: 'gunluk', label: 'Etkinlik günlüğü', badge: '' },
      { href: '/admin/ayarlar', id: 'ayarlar', label: 'Ayarlar', badge: '' },
    ],
  },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Benzinsiz yönetim</title>
  </head>
  <body data-panel={panel} data-pagefind-ignore>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <div class="nav-backdrop" hidden></div>
    <div class="admin-shell">
      <nav class="admin-nav" id="admin-nav" aria-label="Yönetim">
        <a class="brand" href="/admin">
          <svg width="30" height="30" viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="20" fill="none" stroke="#2BD9A4" stroke-width="3.6" stroke-linecap="round" stroke-dasharray="104.2 21.5" transform="rotate(-59 24 24)"></circle>
            <polygon points="26.5,14.8 19.8,25.7 24,25.7 21.5,34 29,22.3 24.8,22.3" fill="#F4F1E8"></polygon>
          </svg>
          <span>Benzinsi<b>z</b></span>
        </a>
        {
          groups.map((group) => (
            <>
              {group.label && <p class="nav-group">{group.label}</p>}
              {group.links.map((link) => (
                <a href={link.href} aria-current={link.id === panel ? 'page' : undefined}>
                  <span>{link.label}</span>
                  {link.badge && <span data-badge={link.badge}></span>}
                </a>
              ))}
            </>
          ))
        }
      </nav>
      <div class="admin-column">
        <header class="admin-top">
          <button class="btn btn-quiet nav-toggle" type="button" aria-controls="admin-nav" aria-expanded="false">Menü</button>
          <div class="admin-search">
            <label class="sr-only" for="admin-q">Ara</label>
            <input id="admin-q" type="search" placeholder="Yazı, araç veya ayar ara (Ctrl K)" />
            <div id="admin-hits" class="admin-hits" hidden></div>
          </div>
          <a class="btn" href="/admin/yazilar?yeni=1">Yeni yazı</a>
          <button class="btn btn-quiet" type="button" data-logout>Çıkış</button>
        </header>
        <main id="icerik" class="admin-main">
          <slot />
        </main>
      </div>
    </div>
    <script>
      import { bootAdmin } from '../scripts/admin-client';
      bootAdmin();
    </script>
  </body>
</html>
