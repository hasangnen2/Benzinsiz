# Kanonik adres. Yayında www kullanılır; kök alan oraya yönlenir. Sonda / olmasın.
PUBLIC_SITE_URL=https://www.benzinsiz.com

# AdSense. Yayıncı kimliği pub- ile başlar. Boşsa reklam betiği yüklenmez,
# alan yine sabit yükseklikte durur. Otomatik reklam kodu yok.
PUBLIC_ADSENSE_PUBLISHER_ID=
PUBLIC_ADSENSE_SLOT_HOME_TOP=
PUBLIC_ADSENSE_SLOT_HOME_MID=
PUBLIC_ADSENSE_SLOT_ARTICLE_EARLY=
PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
PUBLIC_ADSENSE_SLOT_ARTICLE_LATE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Bülten. POST { "email": "..." } ve 2xx beklenir. Boşsa form adres kaydetmez.
# PUBLIC_NEWSLETTER_FORMAT=form ise gövde application/x-www-form-urlencoded olur.
PUBLIC_NEWSLETTER_ENDPOINT=
PUBLIC_NEWSLETTER_FORMAT=json

# Ölçüm: boş | plausible | ga4. Onaydan ve idle sonrasına kadar yüklenmez.
PUBLIC_ANALYTICS=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
PUBLIC_GA4_ID=

# Boşsa veya .example ile bitiyorsa sitede [e-posta adresi] gösterilir.
PUBLIC_CONTACT_EMAIL=

# Google sertifikalı CMP betiği (ör. Funding Choices). Doluysa yerleşik bant
# yerine bu betik yüklenir. Reklam, TCF amaç 1 kullanıcı onayı olmadan açılmaz.
# GDPR uygulanmıyor olsa bile KVKK için kullanıcı eylemi beklenir.
PUBLIC_CMP_SCRIPT_URL=

# Yönetim paneli, tek kullanıcı. Boşsa giriş kapalıdır. Değeri repoya yazma.
ADMIN_PASSWORD=
